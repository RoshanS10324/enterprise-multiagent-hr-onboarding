# UC-04 Equipment & Approved Access Management — environment variables
#
# Copy this file to .env and fill in the values.
# Secrets must come from Azure Key Vault; never commit real credentials.
# In local simulation (IMPLEMENTATION_MODE=LOCAL_SIMULATION), most of these
# are not required — the mock adapters run without any external calls.

# -------------------------------------------------------------------------- runtime mode
# LOCAL_SIMULATION (default) — all adapters are mocks; no external calls
# PRODUCTION — real adapters; all variables below are required
IMPLEMENTATION_MODE=LOCAL_SIMULATION

# -------------------------------------------------------------------------- Microsoft Graph / Outlook connector
# Required for the real OutlookConnector (connectors/outlook/).
# In LOCAL_SIMULATION, MockOutlookConnector is used and these are ignored.
GRAPH_TENANT_ID=<your-entra-tenant-id>
GRAPH_CLIENT_ID=<your-app-registration-client-id>
GRAPH_CLIENT_SECRET=<from-key-vault>
GRAPH_AGENT_MAILBOX=uc04-agent@<your-domain>

# -------------------------------------------------------------------------- IT service desk (MCP endpoint)
# Real IT service desk MCP endpoint — future integration point.
# Not connected in LOCAL_SIMULATION.
ITSD_MCP_ENDPOINT=
ITSD_API_KEY=<from-key-vault>

# -------------------------------------------------------------------------- parent case registry (Cosmos DB)
# Required when integrating with the real parent onboarding orchestrator.
# Not connected in LOCAL_SIMULATION (MockCaseContext is used).
COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
COSMOS_KEY=<from-key-vault>
COSMOS_DATABASE=dact
COSMOS_CONTAINER=onboarding_cases

# -------------------------------------------------------------------------- Azure Key Vault
AZURE_KEYVAULT_URL=https://<your-vault>.vault.azure.net/

# -------------------------------------------------------------------------- API server (run_api.py)
UC04_API_HOST=127.0.0.1
UC04_API_PORT=8004
UC04_API_LOG_LEVEL=info

# -------------------------------------------------------------------------- observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=dact-uc04

# -------------------------------------------------------------------------- general
LOG_LEVEL=INFO
ENV=local
