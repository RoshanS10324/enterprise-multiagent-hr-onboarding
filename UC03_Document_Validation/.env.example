# --- Model access ---
# UC-03 no longer calls Gemini, Claude or OpenAI directly and reads no provider key. Optional model
# help (HR message wording, advisory notes on name variations) goes through the shared DACT LLM
# gateway, configured centrally in HR-Onboarding-Common/.env (LLM_MODE, tier models, key). See
# integrations/gateway/README.md.

# --- Storage ---
# memory (default): in-memory stores, no credentials needed (tests, offline development).
# supabase: UC-03 case state, approvals, audit and validation results in Supabase PostgreSQL through the
# shared Common client, which reads SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from the shared configuration.
# Requires the migration in supabase/migrations/ (proposed, not applied). See integrations/supabase/README.md.
UC03_STORE_MODE=memory

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<from-key-vault>
AZURE_OPENAI_DEPLOYMENT_ORCHESTRATOR=gpt-4o
AZURE_OPENAI_DEPLOYMENT_STAGE=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<from-key-vault>
AZURE_SEARCH_INDEX_NAME=dact-knowledge

# --- Azure Key Vault ---
AZURE_KEYVAULT_URL=https://<your-vault>.vault.azure.net/

# --- HRIS / Graph / IT service desk ---
HRIS_BASE_URL=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
ITSD_BASE_URL=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=dact

# --- App ---
LOG_LEVEL=INFO
ENV=local
