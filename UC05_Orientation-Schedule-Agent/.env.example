# Copy to .env for local overrides. Real environment variables always win. Never commit real keys.
# The defaults below are the SAFE ones: with nothing set, the service refuses to start rather than
# run with trusted headers or in-memory data. The local-development lines are commented out.

# ── Environment ───────────────────────────────────────────────────────────────
# production (default) | staging | development | test
#   development/test: in-memory data allowed; IDENTITY_MODE=insecure-dev-headers allowed
#   staging:          DACT_PERSIST=1 and IDENTITY_MODE=jwt required; runs on the fake connectors
#   production:       DACT_PERSIST=1 and IDENTITY_MODE=jwt required, and fake connectors refused --
#                     no real connector exists yet, so production cannot start (deliberately)
DACT_ENV=production
# DACT_ENV=development

# ── Identity ──────────────────────────────────────────────────────────────────
# jwt (default): `Authorization: Bearer <JWT>` from the organisation's IdP or a trusted gateway.
# User, roles and tenant come from the signed claims; X-User-* / X-Client-Id headers are ignored.
# No real identity provider has been configured or tested; agree the values below with its owners.
IDENTITY_MODE=jwt
IDENTITY_JWT_ISSUER=
IDENTITY_JWT_AUDIENCE=
# Exactly one key source: a PEM public key (inline or file) or the IdP's JWKS endpoint.
IDENTITY_JWT_PUBLIC_KEY_FILE=
# IDENTITY_JWT_PUBLIC_KEY=
# IDENTITY_JWKS_URL=
# Asymmetric algorithms only (RS*/PS*/ES*/EdDSA); none and HS* are refused.
IDENTITY_JWT_ALGORITHMS=RS256,ES256
IDENTITY_JWT_ROLES_CLAIM=roles
IDENTITY_JWT_TENANT_CLAIM=client_id
IDENTITY_JWT_LEEWAY_S=30
IDENTITY_JWT_MAX_AGE_S=3600
# Local development only -- trusts X-User-Id / X-User-Roles / X-Client-Id verbatim. Refused at
# startup unless DACT_ENV is development or test.
# IDENTITY_MODE=insecure-dev-headers

# ── LLM gateway (LiteLLM, via hr_onboarding_common) ──────────────────────────────
# The LLM settings and the OpenRouter key belong in the onboarding system's ONE .env:
# HR-Onboarding-Common/.env (template: HR-Onboarding-Common/.env.example). UC05's API and scheduler
# load it before this file when HR_ONBOARDING_ENV_FILE points to it -- set automatically when the
# orchestrator starts UC05; set it yourself when running UC05 on its own
# (HR-Onboarding-Common/docs/OPENROUTER_INTEGRATION_GUIDE.md §8a).
# offline = deterministic FakeLLM from sub_agent.fakes (no key needed)
# online  = OpenRouter through hr_onboarding_common's LiteLLMGateway (routing, reasoning, retries and
#           fallbacks are all set there); missing key or model stops startup ("live" = "online")
LLM_MODE=offline
# Central configuration (HR-Onboarding-Common/.env.example): DeepSeek V4.1 Flash for every tier, with
# reasoning. Values are OpenRouter model ids; the gateway calls them as openrouter/<model id>.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# LLM_MODEL_FRONTIER=deepseek/deepseek-v4.1-flash
# LLM_MODEL_WORKHORSE=deepseek/deepseek-v4.1-flash
# LLM_MODEL_FAST=deepseek/deepseek-v4.1-flash
# LLM_REASONING_ENABLED=true
# Read by LiteLLM in online mode. Do not put a real key in this example file.
# OPENROUTER_API_KEY=
# Optional LLM tuning (defaults shown): LLM_TIMEOUT_S=120, LLM_MAX_ATTEMPTS=3,
# LLM_REASONING_EFFORT (unset = provider default), LLM_REASONING_TOKEN_HEADROOM=2048,
# LLM_FALLBACKS_FRONTIER / _WORKHORSE / _FAST (comma-separated OpenRouter model ids; none by default),
# LITELLM_CALLBACKS (e.g. "otel").

# ── Connectors ────────────────────────────────────────────────────────────────
# Only "offline" exists: offer-acceptance email, employee directory, calendar, notifications/Teams
# and e-signature are in-memory fakes from sub_agent.fakes. No real adapter, endpoint or credential
# exists in this repository; any other value fails startup.
CONNECTOR_MODE=offline
# FakeSignatureVerifier (test/demo only). No real e-signature provider is implemented.
SIGNATURE_VERIFIER_MODE=offline

# ── Storage ───────────────────────────────────────────────────────────────────
# 1 = every durable store on disk under DACT_DATA_DIR: onboarding.db (cases, sessions, approvals'
# side effects, operation ledger, joining-day jobs -- SQLite, see src/sub_agent/persistence.py for
# what it is and is not suitable for), hitl.db (approvals), checkpoints.db (workflow checkpoints),
# audit.jsonl. Required outside development/test. 0 = all in memory (development/test only).
DACT_PERSIST=1
# DACT_PERSIST=0
DACT_DATA_DIR=.dact
DACT_TZ=Asia/Dubai
LOG_LEVEL=INFO
# Optional: the project root holding guardrails/ when running from an installed package.
# AGENT_HOME=

# ── Joining-day scheduler (python -m sub_agent.scheduler) ────────────────────
# Local time (policy settings.timezone) from which a date's run is due; how many earlier local days
# are still run if missed; claim lease; retries per tenant-date; seconds between ticks.
SCHEDULER_RUN_AT=06:00
SCHEDULER_CATCH_UP_DAYS=2
SCHEDULER_LEASE_S=900
SCHEDULER_MAX_ATTEMPTS=5
SCHEDULER_INTERVAL_S=300

# ── Database (docs/UC05_SUPABASE_INTEGRATION.md) ─────────────────────────────
# mock (default): UC05's local repositories -- in memory, or SQLite with DACT_PERSIST=1. No credentials.
# supabase: the shared Supabase project via PostgREST and the service-role key. Startup fails if a
#           variable is missing, the key is refused, the database is unreachable or a table/column UC05
#           uses is missing -- it never falls back to local or synthetic data.
UC05_DATABASE_MODE=mock
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SCHEMA=public
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key-backend-only>
# SUPABASE_ANON_KEY is NOT used by UC05 (a browser credential governed by RLS).
# Optional: UC05_SUPABASE_TIMEOUT_S=10, UC05_SUPABASE_READ_RETRIES=2, UC05_SUPABASE_VERIFY_SCHEMA=1
# Opt-in live tests (tests/test_supabase_live.py), approved TEST records only:
# UC05_SUPABASE_LIVE_TESTS=1
# UC05_LIVE_TEST_CLIENT_ID=<test-tenant>
# UC05_LIVE_TEST_EMPLOYEE_NO=<employee_no of an approved test case>
# UC05_LIVE_TEST_ALLOW_WRITES=0
