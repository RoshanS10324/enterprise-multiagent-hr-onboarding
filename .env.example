# ==============================================================================
# Enterprise Multi-Agent HR Recruitment & Onboarding Platform
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your deployment environment.
# Defaults are pre-configured for instant zero-dependency local development & testing.

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & ENVIRONMENT MODES
# ------------------------------------------------------------------------------
# Runtime environment: development | staging | production | test
HR_AGENT_ENV=development

# Storage persistence flag: 1 = SQLite/Postgres persistence, 0 = In-Memory
HR_AGENT_PERSIST=1

# Local persistence directory for SQLite state, audit trail & checkpoints
HR_AGENT_DATA_DIR=.agent_data

# Default corporate timezone (IANA format)
HR_AGENT_TZ=Asia/Dubai

# Orchestrator state backend: sqlite | supabase
ORCHESTRATOR_STATE_STORE=sqlite

# Document validator store backend: memory | supabase
UC03_STORE_MODE=memory

# Orientation scheduler database mode: mock | supabase
UC05_DATABASE_MODE=mock

# External connector mode: mock | live
# 'mock' uses isolated local connectors; 'live' binds to Microsoft 365 / Slack / IT ticketing
CONNECTOR_MODE=mock

# ------------------------------------------------------------------------------
# 2. SUPABASE / POSTGRESQL CLUSTER CONFIGURATION (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Supabase project URL and API keys (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Direct or Connection Pooler database URL (PgBouncer / AWS Pooler)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-supabase-project-id.supabase.co:5432/postgres

# Supabase Storage bucket for candidate compliance files & identity docs
DOCUMENT_STORAGE_BUCKET=Doc_Collection

# ------------------------------------------------------------------------------
# 3. LLM GATEWAY & ADVISORY INTELLIGENCE
# ------------------------------------------------------------------------------
# LLM mode: offline (deterministic heuristics only) | online (LiteLLM advisory)
LLM_MODE=offline

# Provider model string (supported via LiteLLM: OpenAI, Anthropic, Gemini, OpenRouter)
LITELLM_MODEL=gemini/gemini-1.5-flash

# API Keys (only required when LLM_MODE=online)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# ------------------------------------------------------------------------------
# 4. ORCHESTRATOR HTTP & SECURITY
# ------------------------------------------------------------------------------
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000

# Allowed CORS origins for the React dashboard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Identity authentication mode: dev-headers (local) | jwt-bearer (production)
IDENTITY_MODE=insecure-dev-headers

# ------------------------------------------------------------------------------
# 5. ENTERPRISE CONNECTORS (OPTIONAL)
# ------------------------------------------------------------------------------
# Microsoft Graph / Azure AD OAuth credentials for automated mailbox intake
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
