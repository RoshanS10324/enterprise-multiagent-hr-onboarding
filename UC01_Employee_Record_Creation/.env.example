# UC-01 local settings.
#
# SHARED configuration (Supabase, LLM routing, DACT_*) belongs in the
# REPOSITORY-ROOT .env, which is loaded after this file and overrides it.
# The Supabase block near the bottom is listed here for discoverability
# only - set it at the root, not per use case.
#
# Neither file is committed (.gitignore). Placeholders only below.

APP_ENV=dev
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
COSMOS_ENDPOINT=
ZOHO_BASE_URL=
DEDUP_HMAC_KEY=change-me
UC01_HRIS_WRITES_ENABLED=true
UC01_SYSTEM_API_KEY=change-me
# Optional override for where policy/uc01_policy.toml is read from; leave
# empty to use the path relative to the installed package (see policy.py).
UC01_POLICY_PATH=

# Where the agent's persona and task prompts live. Defaults to the
# repo-relative brain/ directory; set this when that path doesn't hold
# (the Docker image sets it to /app/brain).
UC01_BRAIN_PATH=

# Attach the advisory model (escalate-only / draft-for-human; it never
# decides). Off by default in code (Settings.llm_enabled=False) so every
# flow is exercised without a model too; true is the dev template default.
UC01_LLM_ENABLED=true
# Which advisory model, when UC01_LLM_ENABLED=true:
#   offline (default) - the deterministic FakeLlm: calls nothing, no key;
#   online            - the central hr_onboarding_common gateway
#                       (src/sub_agent/llm/gateway_client.py). Model tiers
#                       and provider credentials are the SHARED gateway's
#                       settings (LLM_MODEL_* etc. in HR-Onboarding-Common's
#                       .env) - never set a model or provider key for UC-01.
# Same LLM_MODE rule as UC-05 and UC-02. See docs/uc01-llm-gateway.md.
LLM_MODE=offline

# ---------------------------------------------------------------------
# Durable persistence (set these in the ROOT .env, not here)
# ---------------------------------------------------------------------
# Leave SUPABASE_URL empty to use the in-memory adapters. That is
# permitted in APP_ENV=dev only - outside dev, startup fails rather than
# silently running on storage that is lost on restart.
#
# When SUPABASE_URL is set, SUPABASE_SERVICE_ROLE_KEY and
# UC01_FIELD_ENCRYPTION_KEY are both required, and startup performs a
# real connection test.
SUPABASE_URL=
# Project Settings -> API. Server-side only: this key bypasses RLS and
# must never be sent to a browser or committed.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe publishable key. Not used by UC-01's backend; present so
# the shared template is complete.
SUPABASE_ANON_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TIMEOUT_S=15

# AES-256-GCM key for onboarding_forms.salary_and_terms_encrypted.
# 32 random bytes, base64-encoded. Generate with:
#   uv run python -c "from sub_agent.crypto import generate_key_b64; print(generate_key_b64())"
# Rotating this makes existing encrypted salary values unreadable, so
# treat it as managed key material (Key Vault / Supabase Vault), not a
# throwaway. Never commit a real value.
UC01_FIELD_ENCRYPTION_KEY=

# Supabase Storage bucket for received onboarding documents (Supabase mode,
# port "source_documents"). Empty = the source file is not stored; only its
# SHA-256 and size are recorded. Dev uses the existing private bucket.
UC01_DOCUMENT_BUCKET=
