{
  "id": "EC-43",
  "title": "Rehire variant approved by HR then written",
  "covers": ["EC-43"],
  "setup": {
    "client_id": "client-eval-ec43",
    "hr_officer_id": "hr-officer-eval-1",
    "candidate_name": "Riley Returning",
    "candidate_email": "riley.returning@example.test",
    "salary_and_terms": "Base: 115000 SYNTHETIC/yr; benefits: standard"
  },
  "steps": [
    {
      "action": "seed_person_record",
      "as": "SYSTEM",
      "args": {
        "email": "riley.returning@example.test",
        "full_name": "Riley Returning (former)",
        "kind": "PAST_EMPLOYEE"
      }
    },
    {
      "action": "open_case",
      "as": "SYSTEM",
      "args": {},
      "save": "case",
      "expect": {"outcome": "CASE_OPENED"}
    },
    {
      "action": "decide_variant",
      "as": "HR_MANAGER",
      "args": {"approval_id": "$case.approvals_created.0", "approve": true, "note": "confirmed rehire, OK to proceed"}
    },
    {
      "action": "prepare",
      "as": "HR_OFFICER",
      "args": {"case_id": "$case.case.case_id"},
      "save": "prep",
      "expect": {"outcome": "PREPARED"}
    },
    {
      "action": "decide_write",
      "as": "HR_MANAGER",
      "args": {"approval_id": "$prep.approval_id", "approve": true}
    },
    {
      "action": "execute_write",
      "as": "HR_MANAGER",
      "args": {"case_id": "$case.case.case_id"},
      "expect": {"completed": true}
    }
  ],
  "final": {
    "case_ref": "case",
    "stage": "RECORD_CREATED",
    "gateway_writes": 2,
    "audit_actions_present": ["VARIANT_APPROVED", "HRIS_PREPARED", "HRIS_WRITE_SUCCEEDED"],
    "invariants_clean": true
  }
}
