# UC-02 — Onboarding Task Management: environment template.
#
# Loading (one central loader, src/onboarding_task_management/envfile.py), from the UC-02 folder:
#   1. the process environment (PowerShell / shell)  - always wins, never overwritten
#   2. .env.local  - local overrides and the GENERATED development secrets (written only by scripts\setup_dev_environment.ps1)
#   3. .env        - project configuration (copy this file to `.env` and fill in the Supabase values)
# `.env` and `.env.local` are gitignored. This file is tracked and holds PLACEHOLDERS ONLY.
#
# Local development: run `scripts\setup_dev_environment.ps1` once. It sets UC02_STORE_MODE=supabase and UC02_ENV=development
# and generates the five secrets below into `.env.local`. Check with `scripts\check_environment.ps1`.
# Production secrets come from the deployment's secret manager; they are never generated.

# Agent runtime backend: supabase only (memory/sqlite are rejected for the runtime).
UC02_STORE_MODE=supabase
# development | production
UC02_ENV=development

# The five signing secrets (leave empty here; generated into .env.local for development).
UC02_APPROVAL_CALLBACK_SECRET=
UC02_EVENT_SECRET=
UC02_DOCUMENTS_SECRET=
UC02_UC04_STATUS_SECRET=
UC02_UC05_STATUS_SECRET=

# ---------------------------------------------------------------------------
# Persistence (Supabase / Postgres)
#
# STATUS: no Supabase project has been created for UC-02. The migrations in
# `supabase/migrations/` are ready to apply; nothing is provisioned. Until a
# project exists and these are set, UC-02 runs against `InMemoryTableClient`
# and the service keeps its in-memory store — see README "Persistence".
# ---------------------------------------------------------------------------

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Anon/publishable key. Safe for a browser ONLY because Row Level Security is
# enabled and forced on every uc02 table. It still grants no table access:
# the `authenticated` and `anon` roles have no grants in `20261027090100_uc02_rls.sql`.
SUPABASE_ANON_KEY=

# Service-role key. BYPASSES Row Level Security completely.
# - Server-side only. Never ship it to a browser, a mobile app or a CI log.
# - Never commit it. Never paste it into a chat or an issue.
# - UC-02 uses it only from the server-side service, which applies its own
#   client scoping before every query.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by `supabase db push` and by integration
# tests. Format: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
UC02_DATABASE_URL=

# Schema the migrations create. Not `public`, so a shared DACT database cannot
# collide with another use case.
UC02_DB_SCHEMA=uc02

# Opt-in switch for the live-database integration test. Left unset, that test
# skips; the mock-backed persistence tests always run.
UC02_RUN_DB_INTEGRATION_TESTS=0


# ---------------------------------------------------------------------------
# LLM access (ADR-005: LiteLLM is the ONLY path to a model)
#
# Model identifiers are LiteLLM routes, e.g. `anthropic/claude-sonnet-4-5`,
# `gemini/gemini-2.0-flash`, `azure/<deployment>`. Direct provider SDKs are on
# ADR-005's not-approved list: they would be a second route to a model that
# bypasses the gateway, its retry policy and its callbacks.
#
# STATUS: unset in this environment. With no key the agent uses its
# deterministic offline advisor and records `advisor=offline`. No model call
# has been executed or verified.
# ---------------------------------------------------------------------------

# Per-tier routes consumed by hr_recruitment_common.llm.LiteLLMGateway.
# Tier names are the harness's: frontier / workhorse / fast.
# Leave unset to accept the harness defaults in hr_recruitment_common.config.
LLM_MODEL_FRONTIER=
LLM_MODEL_WORKHORSE=
LLM_MODEL_FAST=

# Comma-separated fallback chains, tried in order (ADR-005 §2).
LLM_FALLBACKS_FRONTIER=
LLM_FALLBACKS_WORKHORSE=
LLM_FALLBACKS_FAST=

# Gateway retry/timeout policy (tenacity). LiteLLM's own num_retries is 0 so
# there is exactly one retry policy.
LLM_TIMEOUT_S=120
LLM_MAX_ATTEMPTS=3

# Provider credential for whichever route is configured above. Set exactly the
# one your routes need; leave the rest empty.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=

# Force the deterministic advisor even when a key is present. Useful in CI so
# tests never spend money or depend on a network.
UC02_LLM_OFFLINE=1


# ---------------------------------------------------------------------------
# Shared harness (hr-recruitment-common)
# ---------------------------------------------------------------------------

# Write the harness audit log / HITL inbox / memory to disk instead of memory.
DACT_PERSIST=0


# ---------------------------------------------------------------------------
# Sub-agent layer (onboarding_task_management.agent)
# ---------------------------------------------------------------------------
# Everything below has a working default. The sub-agent runs with NO
# configuration at all: fake LLM, mock Outlook, in-memory state.

# Which deterministic FAKE LLM behaviour to use (model id fake/uc02-advisor-v1).
# No API key is required and none is read.
#   scripted    well-formed scenario-matched advice (default)
#   error       simulates a gateway failure
#   invalid     simulates schema-invalid model output
#   hallucinate well-formed but unsupported advice, to prove it is overruled
UC02_LLM_BEHAVIOUR=scripted

# FastAPI surface (onboarding_task_management.agent.api).
UC02_API_HOST=127.0.0.1
UC02_API_PORT=8000

# Mock only. No Microsoft Graph tenant, client id, secret or mailbox is used,
# and no mail server is contacted. Delivery is simulated in memory.
UC02_OUTLOOK_CONNECTOR=mock
# Simulated delivery still requires an approval id, mirroring the real gate.
UC02_OUTLOOK_APPROVAL_ID=

# No database is wired by default; state is in-memory and does NOT survive a
# restart. Listed so its absence is explicit, not forgotten.
UC02_DB_ENABLED=0

# --- UC-02 runtime persistence --------------------------------------------
# memory (unit tests only) | sqlite (local development) | supabase (actual runtime).
# supabase never falls back to memory or sqlite; an unreachable or incomplete database is an error.
UC02_STORE_MODE=supabase
# Set to production to refuse memory and sqlite modes.
UC02_ENV=
# SUPABASE_URL is preferred; NEXT_PUBLIC_SUPABASE_URL is accepted as a fallback. Server-side only.

# --- Outlook via Microsoft Graph (UC02_OUTLOOK_CONNECTOR=graph). Server side only; see docs/UC02_OUTLOOK_GRAPH_SETUP.md
UC02_GRAPH_TENANT_ID=
UC02_GRAPH_CLIENT_ID=
UC02_GRAPH_CLIENT_SECRET=
UC02_GRAPH_MAILBOX=
# JSON file of approved recipients per client and role (deployment-owned).
UC02_RECIPIENTS_FILE=

# --- HR approval callback (POST /v1/approvals/callback). Without a secret the route refuses every decision (503).
UC02_APPROVAL_CALLBACK_SECRET=
UC02_COORDINATOR_ID=uc02-coordinator

# --- Signed inbound channels and downstream triggers (see docs/UC02_RUNTIME_AND_ACTIVATION.md). All server side.
UC02_EVENT_SECRET=
UC02_DOCUMENTS_SECRET=
UC02_UC04_STATUS_SECRET=
UC02_UC05_STATUS_SECRET=
# Supplied by the UC-04 / UC-05 teams; no URL is assumed. A use case is triggered only when both URL and secret are set.
UC02_UC04_TRIGGER_URL=
UC02_UC04_TRIGGER_SECRET=
UC02_UC05_TRIGGER_URL=
UC02_UC05_TRIGGER_SECRET=
# Shown to HR in the review email as the endpoint the approval connector posts to.
UC02_APPROVAL_CALLBACK_URL=

# --- Synthetic Supabase demo (demo/uc02_supabase_agentic_workflow.py). Development only; never production.
# UC02_STORE_MODE=supabase is REQUIRED for every agent workflow runtime; anything else stops it with an error.
UC02_ENV=development
# Opt in to the synthetic client fixture (a runtime without this refuses synthetic configuration).
UC02_ALLOW_SYNTHETIC_CONFIG=
# Allow the demo's setup stage to insert the synthetic fixture (insert-if-missing). Needs --confirm-write <host>.
UC02_ALLOW_FIXTURE_WRITES=
