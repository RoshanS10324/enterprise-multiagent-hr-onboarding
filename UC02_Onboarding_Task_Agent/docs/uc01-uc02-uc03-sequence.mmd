        UC2-->>UC1: PreconditionError
    else preconditions pass
        UC2->>CFG: registry.get("CLIENT-ALPHA")
        alt no configuration
            CFG-->>UC2: MissingConfigurationError
        else configuration found
            CFG-->>UC2: 12 task templates + 4 milestones
            UC2->>UC2: applicable(location=Dubai,<br/>project=apollo, role=backend_engineer)
            UC2->>UC2: build_tasks() - 10 tasks,<br/>UAE business-day due dates
            UC2->>UC2: recompute_readiness()
            UC2->>AUD: record("onboarding.create", task_count=10)
            UC2-->>UC1: OnboardingRecord<br/>ONB-CLIENT-ALPHA-EMP-001
        end
    end
    end

    rect rgb(237, 233, 254)
    note over UC2: Only hr_record_create is READY.<br/>The other 9 tasks are BLOCKED.
    UC2->>UC2: complete_task(hr_ops, hr_record_create)
    UC2->>AUD: record("task.complete")
    UC2->>UC2: collect_documents, it_laptop,<br/>desk_allocation, orientation_schedule<br/>all become READY in parallel
    end

    rect rgb(254, 243, 199)
    note over UC2,UC3: Trigger 2 [PROPOSED - NOT YET INTEGRATED]
    note right of UC2: UC-02 makes no outbound calls.<br/>It has no HTTP client and no API layer.
    UC2-)UC3: POST /onboarding/uc03/validate<br/>DocumentValidationRequest<br/>case_id, client_id, employee_id,<br/>document_type, document_ref, correlation_id
