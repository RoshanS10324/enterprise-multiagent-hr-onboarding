    note over UC3: Stage F - validation [IMPLEMENTED on origin/Roshan]
    UC3->>UC3: verify_start_conditions()
    alt offer/form not approved
        UC3-->>UC2: ON_HOLD, next_action = NONE
    else start conditions met
        UC3->>UC3: validate identity_document -> ACCEPTED
        UC3->>UC3: validate education_certificate -> ACCEPTED
        UC3->>UC3: validate signed_offer -> ACCEPTED
        UC3->>UC3: validate experience_letter -> MISSING
        opt human judgement needed
            UC3->>UC3: route_to_hr() -> HR_REVIEW_REQUIRED
        end
    end
    end

    rect rgb(254, 243, 199)
